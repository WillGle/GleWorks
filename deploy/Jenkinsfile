pipeline {
    agent {
        docker {
            image 'node:20-alpine'
            args '-v /var/run/docker.sock:/var/run/docker.sock --user root'
        }
    }

    environment {
        IMAGE_NAME = 'glework-frontend'
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        CANDIDATE_CONTAINER = 'glework-frontend-candidate'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install') {
            steps {
                sh 'npm ci'
            }
        }

        stage('Lint') {
            steps {
                sh 'npm run lint'
            }
        }

        stage('Type Check') {
            steps {
                sh 'npm run type-check'
            }
        }

        stage('Test') {
            steps {
                sh 'npm run test:run'
            }
        }

        stage('Build App') {
            steps {
                sh 'npm run build'
            }
        }

        stage('Build Image') {
            steps {
                sh 'apk add --no-cache curl docker-cli'
                sh '''
                    docker build \
                      -f deploy/Dockerfile \
                      -t ${IMAGE_NAME}:${IMAGE_TAG} \
                      -t ${IMAGE_NAME}:latest \
                      .
                '''
            }
        }

        stage('Verify Image') {
            steps {
                sh '''
                    docker stop ${CANDIDATE_CONTAINER} 2>/dev/null || true
                    docker rm ${CANDIDATE_CONTAINER} 2>/dev/null || true

                    docker run -d \
                      -p 8081:80 \
                      --name ${CANDIDATE_CONTAINER} \
                      ${IMAGE_NAME}:${IMAGE_TAG}

                    sleep 5
                    curl -fsS http://localhost:8081/
                '''
            }
        }
    }

    post {
        always {
            sh 'docker stop ${CANDIDATE_CONTAINER} 2>/dev/null || true'
            sh 'docker rm ${CANDIDATE_CONTAINER} 2>/dev/null || true'
        }
    }
}
